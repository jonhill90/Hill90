# =============================================================================
# Hill90 — local development configuration
# =============================================================================
#
# Copy to .env.local and adjust if you like. The defaults work as-is:
#
#   cp .env.local.example .env.local
#   bash scripts/local.sh up
#
# .env.local is gitignored and is ONLY read by scripts/local.sh. Production
# reads nothing from it — every variable below has a production default baked
# into the compose files, so leaving them unset yields the production stack
# byte-for-byte. Verify that yourself any time:
#
#   docker compose -f deploy/compose/prod/docker-compose.infra.yml config
#
# Every variable here must also appear in the compose files, and vice versa.
# scripts/checks/check_env_surface.py enforces that in CI.
# -----------------------------------------------------------------------------


# --- Routing -----------------------------------------------------------------

# localtest.me is a public DNS zone where every name resolves to 127.0.0.1.
# That gives real Host-header routing with no /etc/hosts editing and no
# wildcard-DNS setup. Production default: hill90.com
BASE_DOMAIN=localtest.me

# Subdomain labels. BASE_DOMAIN is appended automatically.
TRAEFIK_HOST=traefik
PORTAINER_HOST=portainer
GRAFANA_HOST=grafana
VAULT_HOST=vault

# Prometheus is routed LOCALLY ONLY, by deploy/compose/overrides/local.observability.yml.
# Production leaves it unrouted on the internal network, reached through Grafana.
PROMETHEUS_HOST=prometheus

# Plain HTTP locally. There is no certificate authority that can validate a
# name resolving to 127.0.0.1, so there is nothing to serve over TLS.
# Production default: websecure
ADMIN_ENTRYPOINT=web

# Production routes admin surfaces through the Tailscale source-IP allowlist
# and, for the dashboard, basic auth backed by a SOPS secret. Neither exists on
# a Mac. compress@file is a real middleware from the same dynamic config, so
# the middleware chain is still exercised rather than being empty.
# Production defaults: tailscale-only@file / auth@file,tailscale-only@file
ADMIN_MIDDLEWARES=compress@file
TRAEFIK_MIDDLEWARES=compress@file

# No ACME locally. Left blank so no router asks for a certificate.
# Production default: letsencrypt-dns
ADMIN_CERT_RESOLVER=

# Traefik's static configuration cannot be templated — see the header of
# platform/edge/traefik.local.yml for why this is a second file rather than an
# override. Production default: traefik.yml
TRAEFIK_STATIC_CONFIG=traefik.local.yml


# --- Service configuration ---------------------------------------------------

# Grafana builds absolute URLs from this. Must match the routed hostname or
# every redirect sends you to production.
# Production default: https://grafana.hill90.com
GRAFANA_ROOT_URL=http://grafana.localtest.me:8080

# Grafana admin password. Production reads this from SOPS; locally it is a
# throwaway because the stack is bound to your own machine.
GRAFANA_ADMIN_PASSWORD=admin

# Traefik dashboard basic-auth hash. Unused locally because TRAEFIK_MIDDLEWARES
# drops auth@file, but the compose file still substitutes it.
TRAEFIK_ADMIN_PASSWORD_HASH=local-unused

# DNS-01 only fires for ACME and there is no ACME locally, so Traefik never
# reads this. Present so the compose substitution resolves.
CF_DNS_API_TOKEN=local-unused


# --- Host ports --------------------------------------------------------------
#
# A Mac often already has something on :80 — including, on the reference
# machine, another Traefik. Published ports are therefore configurable.
# Production binds the real ports and leaves these unset.
# Production defaults: 80 / 443
HTTP_PORT=8080
HTTPS_PORT=8443


# --- Vault storage backend ---------------------------------------------------
#
# Which OpenBao config file to mount and where its data lives. Production
# defaults to the file backend, which is what it has always run. The raft
# variant is selected by .github/workflows/vault-reinitialize.yml at the moment
# the volume is wiped — the only time storage can change for free.
#
# Local development does not run the vault stack, so these are here for the
# parity check rather than for you to set.
#
# Production defaults: config.hcl / /openbao/file
VAULT_CONFIG_FILE=config.hcl
VAULT_DATA_PATH=/openbao/file

# To rehearse the raft switch locally, set these instead and re-run
# `local.sh reset` then `local.sh up`:
#   VAULT_CONFIG_FILE=config.raft.hcl
#   VAULT_DATA_PATH=/openbao/raft


# --- Platform credentials (local throwaways) ---------------------------------
#
# Production supplies these from SOPS and the compose files deliberately give
# them NO default — a database password that falls back to a known value is a
# footgun, and check_env_surface.py enforces that. Local therefore has to state
# its own, and these are disposable.
DB_USER=hill90
DB_PASSWORD=localdev
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# Substituted into platform-realm.json at import as the hill90-vault client
# secret, and read back by 'local.sh vault setup-oidc'. BOTH sides must agree,
# so if you rehearse OIDC locally this value must also be the
# VAULT_OIDC_CLIENT_SECRET in .local-vault/local.enc.env. Disposable locally.
VAULT_OIDC_CLIENT_SECRET=local-rehearsal-secret-0123456789

# --- The tenant's OIDC clients in realm platform ------------------------------
# platform-realm.json carries hill90-ui and hill90-api so a LOCAL platform
# Keycloak can serve the tenant the same way production's does. That is what
# makes local prove TENANCY and not merely the realm design.
#
# The client's redirect URI and web origin stay at their PRODUCTION values in
# platform-realm.json; local.sh appends the local callback to the running client
# instead, the same delta it already applies to hill90-vault. The secret is
# disposable locally, but it must equal the
# AUTH_KEYCLOAK_SECRET the tenant's local stack holds or the token exchange fails
# with invalid_client — the same failure that cost this estate a night in
# production.
HILL90_UI_CLIENT_SECRET=local-tenant-ui-secret-0123456789

# Where the tenant's local UI listens, used only to add its OIDC callback to the
# running hill90-ui client. Must match hill90-app's local UI port (its PORT_UI).
TENANT_UI_PORT=13000

# --- Keycloak SSO for the platform services (issue #530) ---------------------
# Keycloak's public base URL and realm, as the OTHER services must reach it.
# Production defaults to https://auth.hill90.com and the 'platform' realm.
KC_PUBLIC_URL=http://auth.localtest.me:8080
KC_REALM=platform

# OIDC client secrets. keycloak.sh writes these INTO Keycloak and the services
# read the same values, so both sides agree by construction. Disposable locally.
# Set to false to bring Grafana up with SSO switched off entirely — the
# quickest way to rule OAuth out when debugging a login problem.
GRAFANA_OIDC_ENABLED=true
GRAFANA_OIDC_CLIENT_SECRET=local-grafana-secret-0123456789
PORTAINER_OIDC_CLIENT_SECRET=local-portainer-secret-0123456789

# --- Object store (MinIO) ----------------------------------------------------
# Root credentials for the local object store. Disposable; production keeps its
# own in SOPS.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=localdev-minio-password
# Gates the S3/STS path against Keycloak. MinIO's console has NO SSO login in
# the AGPL build (removed May 2025), so this does not give you a login button.
MINIO_OIDC_CLIENT_SECRET=local-minio-secret-0123456789

# Routing. Production resolves to storage.hill90.com with no environment set.
MINIO_HOST=storage
MINIO_PUBLIC_URL=http://storage.localtest.me:8080
# The token claim MinIO reads the policy name from. keycloak.sh emits it.
MINIO_OIDC_CLAIM_NAME=minio_policy

# The local Portainer admin. portainer.sh uses it to call the Portainer API, and
# it is your way in when Keycloak is unavailable. Portainer 2.39 requires the
# admin to be created within a few minutes of first start, using a setup token
# from its logs — 'local.sh sso' tells you how if it is missing.
PORTAINER_ADMIN_USERNAME=admin
PORTAINER_ADMIN_PASSWORD=localdev-portainer-pw


# --- Public-facing routing (Keycloak) ----------------------------------------
#
# Keycloak is the one platform service on a PUBLIC hostname — an identity
# provider that only works from inside the tailnet cannot serve family or demo
# accounts. It therefore uses the HTTP-01 resolver, not the Tailscale-only one.
#
# Production defaults: auth / websecure / letsencrypt
AUTH_HOST=auth
PUBLIC_ENTRYPOINT=web
PUBLIC_CERT_RESOLVER=

# Keycloak builds absolute URLs from this; it must match the routed hostname.
# Production default: https://auth.hill90.com
KC_HOSTNAME=http://auth.localtest.me:8080


# --- Namespacing -------------------------------------------------------------
#
# A developer Mac may already be running other Docker projects — including, as
# it happens, an older Hill90 app stack with a container literally named
# "traefik". Local resources are therefore prefixed so they can never collide
# with, or be mistaken for, anything else. Production leaves all three unset and
# keeps its historical names exactly.
#
# The prefix must not collide with anything else on the machine. "hill90local"
# was the first choice and turned out to collide with an older Hill90 app stack
# already running here, which attaches to hill90local_edge and
# hill90local_internal — sharing those silently, and letting a teardown remove a
# network the other stack still needs. local.sh now refuses to start if a target
# network is owned by a different compose project, so if you hit that, change
# this prefix rather than working around it.
#
# Production defaults: CONTAINER_PREFIX="" NETWORK_PREFIX=hill90 VOLUME_PREFIX=prod
CONTAINER_PREFIX=hill90dev-
NETWORK_PREFIX=hill90dev
VOLUME_PREFIX=hill90dev
VOLUME_PREFIX_BARE=hill90dev-

# Hold minio's Traefik router dark across deploys (cutover only). Default true.
MINIO_TRAEFIK_ENABLE=true
