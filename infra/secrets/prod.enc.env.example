# Example Production Secrets
# Copy this to prod.env, fill in values, then encrypt with:
# sops -e prod.env > prod.enc.env && rm prod.env

# VPS Configuration
VPS_HOST=hill90-vps
VPS_IP=REPLACE_WITH_VPS_IP
TAILSCALE_AUTH_KEY=tskey-auth-REPLACE

# JWT Secrets

# Service Secrets

# API Keys

# UI Auth (NextAuth)

# Verification User (for supported-path UI/runtime checks)

# Email (ACME)
ACME_EMAIL=admin@hill90.com
ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Traefik Dashboard
TRAEFIK_ADMIN_PASSWORD_HASH=REPLACE_WITH_HTPASSWD_HASH

# ACME DNS-01 (Cloudflare). Token scoped to the hill90.com zone with
# Zone/Zone/Read + Zone/DNS/Edit. Not a Global API Key.
CF_DNS_API_TOKEN=REPLACE_WITH_CLOUDFLARE_DNS_API_TOKEN

# VPS management (Hostinger is still the VPS host — not a DNS credential)
HOSTINGER_API_KEY=REPLACE_WITH_HOSTINGER_API_KEY

# SMTP (Hostinger)

# Observability
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_GRAFANA_PASSWORD

# GitHub Container Registry
GHCR_TOKEN=ghp_REPLACE

# OpenBao (Vault) — unseal key + per-service AppRole credentials
OPENBAO_UNSEAL_KEY=REPLACE_WITH_UNSEAL_KEY
VAULT_INFRA_ROLE_ID=REPLACE_WITH_ROLE_ID
VAULT_INFRA_SECRET_ID=REPLACE_WITH_SECRET_ID
VAULT_OBSERVABILITY_ROLE_ID=REPLACE_WITH_ROLE_ID
VAULT_OBSERVABILITY_SECRET_ID=REPLACE_WITH_SECRET_ID
# Already present in the real prod.enc.env — orphaned by #495, live again now
# the object store exists.
VAULT_MINIO_ROLE_ID=REPLACE_WITH_ROLE_ID
VAULT_MINIO_SECRET_ID=REPLACE_WITH_SECRET_ID
# Note: mcp and vault have no compose secret refs — no AppRole creds needed

# Vault sync token (read-only, for automated vault-to-SOPS sync)
VAULT_SYNC_TOKEN=REPLACE_WITH_SYNC_TOKEN

# Agent Knowledge Manager (AKM)

# --- Platform database (Postgres) --------------------------------------------
DB_USER=hill90
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
DB_NAME=hill90

# --- Tenant logins on the platform database ----------------------------------
# The hill90-app tenant's login, created by scripts/provision-tenant-db.sh. No
# compose file here references it: this platform SETS the credential, and the
# tenant consumes it from its own repository. Rotating it means re-running the
# provisioner, which is idempotent.
HILL90_APP_DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# --- Tenant OIDC clients in realm platform -----------------------------------
# hill90-ui's client secret, substituted into platform-realm.json at import.
# MUST equal the value hill90-app holds, or the tenant cannot sign in after a
# realm re-import. The live realm is already configured, so this matters at
# rebuild time.
HILL90_UI_CLIENT_SECRET=REPLACE_WITH_SECURE_SECRET

# --- Platform identity provider (Keycloak) -----------------------------------
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# OIDC client secret for the hill90-vault client in the Keycloak platform realm.
# Lets OpenBao authenticate humans via SSO. Created with the realm.
# Substituted into platform-realm.json at import, written onto the live client
# by scripts/keycloak.sh apply, and read by vault.sh setup-oidc. All three read
# THIS value, so generate a strong random string BEFORE the first auth deploy.
#
# If it is missing at import time the placeholder resolves to an empty string
# and Keycloak creates hill90-vault as a confidential client whose secret is "".
# That is what happened in production: the client existed, looked fine, and
# keycloak.sh apply then refused to reconfigure anything because the secret it
# needed did not exist. Do not leave this unset.
VAULT_OIDC_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET

# --- Keycloak SSO for platform services (issue #530) -------------------------
# scripts/keycloak.sh writes these INTO Keycloak and the services read the same
# values, so both sides agree by construction. Set them to strong random
# strings; they are not copied out of Keycloak.
GRAFANA_OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET

# --- Object store (MinIO) ----------------------------------------------------
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD already exist in the real prod.enc.env:
# they outlived the service when MinIO was removed in #495. Keep the existing
# values — the prod_minio-data volume was never deleted, and rotating the root
# credential is a separate, deliberate act.
MINIO_ROOT_USER=REPLACE_WITH_EXISTING_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_EXISTING_MINIO_ROOT_PASSWORD
# Written INTO Keycloak by scripts/keycloak.sh and read by MinIO, so both sides
# agree by construction. This gates the S3/STS path only — MinIO's console has
# no SSO login in the AGPL build.
MINIO_OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET
PORTAINER_OIDC_CLIENT_SECRET=REPLACE_WITH_RANDOM_SECRET

# The EXISTING local Portainer admin password. scripts/portainer.sh needs it to
# call the Portainer API; it does not set or change it. This is also the
# fallback login when Keycloak is unavailable — see docs/runbooks/sso-fallback.md.
PORTAINER_ADMIN_PASSWORD=REPLACE_WITH_EXISTING_PORTAINER_ADMIN_PASSWORD

# AppRole credentials for the platform stacks.
VAULT_DB_ROLE_ID=REPLACE
VAULT_DB_SECRET_ID=REPLACE
VAULT_AUTH_ROLE_ID=REPLACE
VAULT_AUTH_SECRET_ID=REPLACE
